{
  "version": 1,
  "description": "Semantics of the client-evaluated FilterSpec subset (docs/QUERY-IR.md \"Client-evaluated subset\"): each case is one filter, one event's properties and whether the filter matches that event. The expectations are what compile() returns in Postgres (apps/server/src/replays/client-filter-cases.test.ts runs every case there); an SDK that evaluates these filters must give the same answers. An absent key is a property missing from `properties`. Comparing an object or array property with eq, neq or contains is left out on purpose: Postgres compares the jsonb text form, which an SDK cannot reproduce byte for byte.",
  "cases": [
    {
      "name": "eq string matches the same string",
      "filter": {
        "kind": "property",
        "scope": "event",
        "key": "p",
        "op": "eq",
        "value": "pro"
      },
      "properties": {
        "p": "pro"
      },
      "expected": true
    },
    {
      "name": "eq string is case sensitive",
      "filter": {
        "kind": "property",
        "scope": "event",
        "key": "p",
        "op": "eq",
        "value": "pro"
      },
      "properties": {
        "p": "Pro"
      },
      "expected": false
    },
    {
      "name": "eq string does not match an absent key",
      "filter": {
        "kind": "property",
        "scope": "event",
        "key": "p",
        "op": "eq",
        "value": "pro"
      },
      "properties": {},
      "expected": false
    },
    {
      "name": "eq string does not match JSON null",
      "filter": {
        "kind": "property",
        "scope": "event",
        "key": "p",
        "op": "eq",
        "value": "pro"
      },
      "properties": {
        "p": null
      },
      "expected": false
    },
